{% autoescape 'html' %}{% if c.secret %}<input type="password" name="cfg:{{ c.key }}" value="" autocomplete="off" placeholder="{% if c.hasValue %}{{ locale.hk_guardado_escribe_para_cambiarlo|raw }}{% else %}{{ locale.hk_vacio|raw }}{% endif %}">{% elseif c.bool %}<select name="cfg:{{ c.key }}" style="width:auto"><option value="true" {% if c.value == 'true' %}selected{% endif %}>{{ locale.hk_true_si|raw }}</option><option value="false" {% if c.value == 'false' %}selected{% endif %}>{{ locale.hk_false_no|raw }}</option></select>{% elseif c.long %}<textarea name="cfg:{{ c.key }}" rows="2">{{ c.value }}</textarea>{% else %}<input type="text" name="cfg:{{ c.key }}" value="{{ c.value }}">{% endif %}{% endautoescape %}
